[Unit]
Description=Rusticket Telegram server agent
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/rusticket-agent.env
ExecStart=/usr/bin/python3 /opt/rusticket/server-admin-agent/agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

