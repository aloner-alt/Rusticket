FROM node:24-bookworm-slim
WORKDIR /app
RUN npm install --global pnpm@11.19.0 && mkdir -p /data && chown node:node /data
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY --chown=node:node src ./src
COPY --chown=node:node server ./server
COPY --chown=node:node wrangler.toml ./wrangler.toml
USER node
ENV NODE_ENV=production PORT=3000 SQLITE_PATH=/data/rusticket.sqlite
CMD ["pnpm", "exec", "tsx", "server/index.ts"]
